<!DOCTYPE html>
<html lang="en" data-theme="forest">

<head>
    <title>spotDL</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="module" src="/assets/datastar.js"></script>
    <link href="/assets/daisyui@5.css" rel="stylesheet" type="text/css" />
    <link href="/assets/themes.css" rel="stylesheet" type="text/css" />
    <script src="/assets/tailwindcss/browser@4.js"></script>
    <script src="/assets/iconify-icon/iconify-icon.min.js"></script>
</head>

<style>
    html, body { min-height: 100vh; overflow-x: hidden; }
    iconify-icon { display: inline-block; width: 1em; height: 1em; }

    /* === Core Theme === */
    .app-bg {
        background: #030712;
        background-image:
            radial-gradient(ellipse at 25% 0%, rgba(0,212,255,0.04) 0%, transparent 50%),
            radial-gradient(ellipse at 75% 100%, rgba(0,102,255,0.03) 0%, transparent 50%);
    }

    /* Glass card */
    .glass {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(0,212,255,0.06);
        border-radius: 12px;
    }
    .glass:hover {
        background: rgba(0,212,255,0.03);
        border-color: rgba(0,212,255,0.12);
    }

    /* Accent */
    .neon { color: #00d4ff; }
    .neon-bg { background: #00d4ff; }
    .neon-glow { box-shadow: 0 0 24px rgba(0,212,255,0.12); }

    /* Buttons */
    .btn-neon {
        background: linear-gradient(135deg, #00d4ff 0%, #0066ff 100%);
        color: #020617;
        border: none;
        font-weight: 600;
    }
    .btn-neon:hover {
        background: linear-gradient(135deg, #22d3ee 0%, #3b82f6 100%);
        box-shadow: 0 0 20px rgba(0,212,255,0.25);
    }
    .btn-glass {
        background: rgba(0,212,255,0.06);
        color: #00d4ff;
        border: 1px solid rgba(0,212,255,0.12);
    }
    .btn-glass:hover {
        background: rgba(0,212,255,0.12);
        border-color: rgba(0,212,255,0.25);
    }

    /* Progress */
    .progress-neon::-webkit-progress-value {
        background: linear-gradient(90deg, #00d4ff, #0066ff);
        border-radius: 999px;
    }
    .progress-neon::-moz-progress-bar {
        background: linear-gradient(90deg, #00d4ff, #0066ff);
        border-radius: 999px;
    }

    /* Mono */
    .mono { font-family: 'SF Mono','Cascadia Code','Consolas','Fira Code',monospace; }

    /* Pulse indicator */
    @keyframes neon-pulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0,212,255,0.4); }
        50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(0,212,255,0); }
    }
    .pulse-dot {
        width: 7px; height: 7px;
        background: #00d4ff;
        border-radius: 50%;
        animation: neon-pulse 2s ease-in-out infinite;
    }

    /* Separator line */
    .neon-line { height: 1px; background: linear-gradient(90deg, transparent, rgba(0,212,255,0.12), transparent); }

    /* Transitions */
    .ts { transition: all 0.2s ease; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(0,212,255,0.08); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(0,212,255,0.15); }

    /* Animations */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .fade-up { animation: fadeUp 0.3s ease forwards; }
    .stagger > * { opacity: 0; animation: fadeUp 0.25s ease forwards; }
    .stagger > *:nth-child(1) { animation-delay:.03s }
    .stagger > *:nth-child(2) { animation-delay:.06s }
    .stagger > *:nth-child(3) { animation-delay:.09s }
    .stagger > *:nth-child(4) { animation-delay:.12s }
    .stagger > *:nth-child(5) { animation-delay:.15s }
    .stagger > *:nth-child(6) { animation-delay:.18s }
    .stagger > *:nth-child(7) { animation-delay:.21s }
    .stagger > *:nth-child(8) { animation-delay:.24s }

    /* Input glow */
    .input-glow:focus-within { border-color: rgba(0,212,255,0.3); box-shadow: 0 0 0 3px rgba(0,212,255,0.06); }
</style>

<script>
    function goto(location) { window.location.href = location; }
    function storageGet(key) { try { return localStorage.getItem(key); } catch(e) { return null; } }
    function storageSet(key, val) { try { localStorage.setItem(key, val); } catch(e) {} }
    (function() {
        var saved = storageGet('spotdl-theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
</script>

<body data-signals="{'client_id': ''}"
    data-on-load="$client_id = storageGet('client_id') || ''; @get('/client/load')">

    <div class="app-bg min-h-screen flex flex-col text-gray-300">
        {% include "navbar.html.j2" %}
        <div class="flex-1">
            {% block content %}{% endblock content %}
        </div>
        {% include "footer.html.j2" %}
        <div id="toast-container" class="toast toast-end toast-bottom z-50"></div>
        <span id="component-settings"
            data-on-signal-patch="@get('/client/component/settings-content'); storageSet('client_id', $client_id);"
            data-on-signal-patch-filter="{include: /client_id/}">
        </span>
        <dialog id="settings_modal" class="modal modal-bottom sm:modal-middle">
            <div id="component-settings-content"></div>
            <form method="dialog" class="modal-backdrop"><button>close</button></form>
        </dialog>
    </div>
</body>
</html>
