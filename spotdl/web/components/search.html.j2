{% extends "base.html.j2" %}
{% block content %}
<div data-signals='{"search_term": {{ search_term|tojson }}}'>
    <div class="min-h-screen px-4 py-6">
        <span id="search-list" class="flex items-center justify-center py-24">
            <div class="text-center fade-in" data-on-load="@get('/client/search')">
                <span class="loading loading-spinner loading-md" style="color: var(--accent);"></span>
                <p class="mt-4 text-sm text-muted">Searching...</p>
            </div>
        </span>
    </div>
</div>
{% endblock content %}
