<input id="input-rotating-placeholder" type="text" placeholder="{{ placeholder_item|e }}"
    class="w-full bg-transparent border-0 px-2 py-1.5 text-sm text-white placeholder-gray-600 focus:outline-none rounded-lg ts"
    style="background:rgba(0,212,255,0.03); border:1px solid rgba(0,212,255,0.06);"
    data-bind="search_term"
    data-on-keydown="if(evt.key==='Enter' && $search_term.trim()) goto('/search?q=' + encodeURIComponent($search_term))">
</input>
