<input id="input-rotating-placeholder" type="text" placeholder="{{ placeholder_item }}"
    class="w-full bg-transparent border-0 px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none rounded-lg"
    style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);"
    data-bind="search_term"
    data-on-keydown="evt.key === 'Enter' && goto('/search?q=' + $search_term)">
</input>
