<div id="search-list" data-signals="{'song_url': {}}" class="max-w-3xl mx-auto px-2 sm:px-4 py-2 stagger">
    {% for song in songs %}
    <div key="{{loop.index0}}" class="glass mb-2 ts hover:scale-[1.003] fade-up" style="opacity:0">
        <div class="flex items-center gap-3 p-3">
            <img src="{{ song.cover_url|e }}"
                class="w-11 h-11 rounded-lg object-cover shrink-0" loading="lazy" alt="{{ song.name|e }}" />
            <div class="flex-1 min-w-0">
                <p class="font-medium text-sm text-white truncate">
                    {{ song.name|e }}
                    {% if song.explicit %}
                    <span class="inline-block px-1 rounded text-[9px] font-bold ml-1 align-middle"
                        style="background:rgba(0,212,255,0.1); color:rgba(0,212,255,0.6);">E</span>
                    {% endif %}
                </p>
                <p class="text-xs opacity-35 truncate">
                    {% for artist in song.artists %}{% if not loop.first %}, {% endif %}{{ artist|e }}{% endfor %}
                    {% if song.album_name %}&middot; {{ song.album_name|e }}{% endif %}
                </p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
                <a class="btn btn-ghost btn-circle btn-xs opacity-25 hover:opacity-70 ts"
                    href="{{ song.url|e }}" target="_blank" rel="noopener noreferrer">
                    <iconify-icon icon="clarity:pop-out-line" style="font-size: 13px"></iconify-icon>
                </a>
                <button id="{{ safe_id(song.url) }}"
                    class="btn btn-circle btn-xs btn-neon ts"
                    data-on-click="$song_url = '{{song.url|e}}'; @post('/client/download/');">
                    <iconify-icon icon="clarity:download-line" style="font-size: 13px"></iconify-icon>
                </button>
            </div>
        </div>
    </div>
    {% endfor %}

    {% if not songs %}
    <div class="flex flex-col items-center justify-center py-20 opacity-25">
        <iconify-icon icon="clarity:search-line" style="font-size: 36px" class="mb-3 neon"></iconify-icon>
        <p class="text-sm">No results found</p>
    </div>
    {% endif %}
</div>
