<div class="modal-box relative" id="component-settings-content"
    style="background: rgba(3,7,18,0.97); border: 1px solid rgba(0,212,255,0.08); backdrop-filter: blur(20px);">
    <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 opacity-25 hover:opacity-70 ts"
            data-on-click="@get('/client/settings')">
            <iconify-icon icon="clarity:close-line" style="font-size: 15px"></iconify-icon>
        </button>
    </form>

    <div class="flex items-center gap-2 mb-5">
        <iconify-icon icon="clarity:settings-line" style="font-size: 18px" class="neon"></iconify-icon>
        <h3 class="font-bold text-sm text-white tracking-wide uppercase">Settings</h3>
    </div>

    <div class="flex flex-col gap-3">
        <div class="rounded-xl p-3" style="background:rgba(0,212,255,0.02); border:1px solid rgba(0,212,255,0.05);">
            <h4 class="text-[10px] font-semibold opacity-35 mb-2 uppercase tracking-widest mono">Audio Providers</h4>
            {% for provider in AUDIO_PROVIDERS %}
            <label class="flex items-center gap-2.5 cursor-pointer px-1.5 py-1 rounded-lg hover:bg-cyan-500/[0.03] ts">
                <input type="checkbox" {% if provider in downloader_settings.audio_providers %}checked{% endif %}
                    class="checkbox checkbox-xs"
                    style="border-color: rgba(0,212,255,0.2);"
                    data-on-change="if(evt.target.checked){$downloader_settings.audio_providers.push('{{provider}}')}else{$downloader_settings.audio_providers=$downloader_settings.audio_providers.filter(i=>i!=='{{provider}}')}" />
                <span class="text-sm opacity-50">{{ provider }}</span>
            </label>
            {% endfor %}
        </div>

        <div class="rounded-xl p-3" style="background:rgba(0,212,255,0.02); border:1px solid rgba(0,212,255,0.05);">
            <h4 class="text-[10px] font-semibold opacity-35 mb-2 uppercase tracking-widest mono">Lyrics Providers</h4>
            {% for provider in LYRICS_PROVIDERS %}
            <label class="flex items-center gap-2.5 cursor-pointer px-1.5 py-1 rounded-lg hover:bg-cyan-500/[0.03] ts">
                <input type="checkbox" {% if provider in downloader_settings.lyrics_providers %}checked{% endif %}
                    class="checkbox checkbox-xs"
                    style="border-color: rgba(0,212,255,0.2);"
                    data-on-change="if(evt.target.checked){$downloader_settings.lyrics_providers.push('{{provider}}')}else{$downloader_settings.lyrics_providers=$downloader_settings.lyrics_providers.filter(i=>i!=='{{provider}}')}" />
                <span class="text-sm opacity-50">{{ provider }}</span>
            </label>
            {% endfor %}
        </div>

        <div class="rounded-xl p-3" style="background:rgba(0,212,255,0.02); border:1px solid rgba(0,212,255,0.05);">
            <h4 class="text-[10px] font-semibold opacity-35 mb-2 uppercase tracking-widest mono">Output Format</h4>
            <select class="select select-sm w-full bg-transparent text-sm" style="border:1px solid rgba(0,212,255,0.1);"
                data-on-change="$downloader_settings.format=evt.target.options[evt.target.selectedIndex].value">
                {% for format in FORMATS %}
                <option value="{{format}}" {% if format==downloader_settings.format %}selected{% endif %}
                    style="background:#030712;">{{format}}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <div id="settings-status" class="mt-3"></div>

    <div class="flex justify-end gap-2 mt-5">
        <form method="dialog">
            <button class="btn btn-sm btn-ghost opacity-35 hover:opacity-70 ts"
                data-on-click="@get('/client/settings')">Cancel</button>
        </form>
        <button class="btn btn-sm btn-neon rounded-lg ts" data-on-click="@post('/client/settings')">Save</button>
    </div>
</div>
