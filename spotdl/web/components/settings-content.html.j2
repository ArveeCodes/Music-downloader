{% from "icons.html.j2" import icon %}
<div class="modal-box minimal relative" id="component-settings-content">
    <form method="dialog">
        <button class="icon-btn absolute right-3 top-3" data-on-click="@get('/client/settings')">
            {{ icon('close', 16) }}
        </button>
    </form>

    <div class="flex items-center gap-2 mb-6">
        <span class="text-accent">{{ icon('settings', 18) }}</span>
        <h3 class="font-semibold text-base">Settings</h3>
    </div>

    <div class="flex flex-col gap-6">
        <!-- Audio Providers -->
        <div>
            <p class="section-label">Audio providers</p>
            <div class="panel">
                {% for provider in AUDIO_PROVIDERS %}
                <label class="row cursor-pointer" style="padding: 8px 14px;">
                    <input type="checkbox" {% if provider in downloader_settings.audio_providers %} checked="checked" {% endif %}
                        class="checkbox checkbox-sm"
                        id="{{ provider }}" name="{{ provider }}"
                        data-on-change="if (evt.target.checked) { $downloader_settings.audio_providers.push('{{ provider }}') } else { $downloader_settings.audio_providers = $downloader_settings.audio_providers.filter(item => item !== '{{ provider }}') }" />
                    <span class="text-sm text-muted">{{ provider }}</span>
                </label>
                {% endfor %}
            </div>
        </div>

        <!-- Lyrics Providers -->
        <div>
            <p class="section-label">Lyrics providers</p>
            <div class="panel">
                {% for provider in LYRICS_PROVIDERS %}
                <label class="row cursor-pointer" style="padding: 8px 14px;">
                    <input type="checkbox" {% if provider in downloader_settings.lyrics_providers %} checked="checked" {% endif %}
                        class="checkbox checkbox-sm"
                        id="{{ provider }}" name="{{ provider }}"
                        data-on-change="if (evt.target.checked) { $downloader_settings.lyrics_providers.push('{{ provider }}') } else { $downloader_settings.lyrics_providers = $downloader_settings.lyrics_providers.filter(item => item !== '{{ provider }}') }" />
                    <span class="text-sm text-muted">{{ provider }}</span>
                </label>
                {% endfor %}
            </div>
        </div>

        <!-- Output Format -->
        <div>
            <p class="section-label">Output format</p>
            <select class="select w-full text-sm"
                style="background: var(--surface); border: 1px solid var(--line); border-radius: 10px; color: var(--text);"
                data-on-change="$downloader_settings.format = evt.target.options[evt.target.selectedIndex].value">
                {% for format in FORMATS %}
                <option value="{{ format }}" {% if format == downloader_settings.format %}selected{% endif %}
                    style="background: var(--surface);">
                    {{ format }}
                </option>
                {% endfor %}
            </select>
        </div>
    </div>

    <!-- Status Messages -->
    <div id="settings-status" class="mt-4"></div>

    <!-- Actions -->
    <div class="flex justify-end gap-2 mt-6">
        <form method="dialog">
            <button class="icon-btn w-auto px-4 rounded-lg text-sm" style="width: auto; border-radius: 10px;"
                data-on-click="@get('/client/settings')">
                Cancel
            </button>
        </form>
        <button class="btn-accent text-sm" data-on-click="@post('/client/settings')">
            Save changes
        </button>
    </div>
</div>
