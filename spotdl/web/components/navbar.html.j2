<div class="navbar bg-base-100/80 backdrop-blur-md sticky top-0 z-40 border-b border-base-content/5 px-4 shadow-sm">

  <div class="navbar-start gap-2">
    <a class="flex items-center gap-2 cursor-pointer group" onclick="goto('/')">
      <img src="../assets/spotdl.svg" class="w-8 h-8 group-hover:scale-110 transition-transform" alt="spotDL" />
      <span class="font-bold text-lg tracking-tight hidden sm:inline">spotDL</span>
    </a>
  </div>

  <div class="navbar-center w-full max-w-md px-2">
    <div id="search-input" data-signals="{search_term: '', loading: false}" class="w-full">
      <div class="join w-full">
        <input id="nav-search-input" type="text"
            class="input input-sm sm:input-md join-item w-full bg-base-200/50 focus:bg-base-200 border-base-content/10 focus:border-primary/50 placeholder:text-base-content/40"
            data-bind="search_term"
            data-on-keydown="evt.key === 'Enter' && $search_term && goto('/search?q=' + encodeURIComponent($search_term))" />
        <button class="btn btn-sm sm:btn-md btn-primary join-item px-3"
            data-on-click="$search_term && goto('/search?q=' + encodeURIComponent($search_term))">
            <iconify-icon icon="clarity:search-line" style="font-size: 18px"></iconify-icon>
        </button>
      </div>
    </div>
  </div>

  <div class="navbar-end gap-1">
    <div id="status" class="btn btn-ghost btn-circle btn-sm">
      <iconify-icon icon="clarity:disconnect-line" style="font-size: 18px"></iconify-icon>
    </div>

    <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm">
      <input type="checkbox" id="theme-toggle"
          data-on-change="setTheme(evt.target.checked ? 'light' : 'forest')" />
      <iconify-icon icon="clarity:sun-line" class="swap-on" style="font-size: 18px"></iconify-icon>
      <iconify-icon icon="clarity:moon-line" class="swap-off" style="font-size: 18px"></iconify-icon>
    </label>

    {% include "settings.html" %}

    <div class="indicator">
      <span class="indicator-item badge badge-primary badge-xs p-1 text-[10px] font-bold">
        <span id="overall-completed-tasks">0</span>
      </span>
      <a class="btn btn-ghost btn-circle btn-sm" data-on-click="goto('/downloads')">
        <iconify-icon icon="clarity:download-cloud-line" style="font-size: 18px"></iconify-icon>
      </a>
    </div>
  </div>
</div>

<script>
(function() {
    var saved = localStorage.getItem('spotdl-theme');
    var toggle = document.getElementById('theme-toggle');
    if (toggle && saved === 'light') toggle.checked = true;

    var placeholders = [
        "All Eyes On Me - Bo Burnham",
        "https://open.spotify.com/track/4vfN00PlILRXy5dcXHQE9M",
        "Lil Wayne",
        "Drive - Miley Cyrus",
        "Sofia - TMG",
        "Lightning Crashes - Live",
    ];
    var idx = 0;
    var input = document.getElementById('nav-search-input');
    if (input && !input.value) {
        input.placeholder = placeholders[0];
        setInterval(function() {
            idx = (idx + 1) % placeholders.length;
            input.style.transition = 'opacity 0.2s';
            input.style.opacity = '0.5';
            setTimeout(function() {
                input.placeholder = placeholders[idx];
                input.style.opacity = '1';
            }, 200);
        }, 4000);
    }
})();
</script>
