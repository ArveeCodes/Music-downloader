{% from "icons.html.j2" import icon %}
<div class="nav-shell">
  <div class="max-w-5xl mx-auto flex items-center gap-3 px-4 h-14">

    <!-- Logo -->
    <div class="flex items-center gap-2.5 cursor-pointer shrink-0 select-none" data-on-click="goto('/')">
      <img src="/assets/spotdl.svg" class="w-7 h-7" alt="Kraken" />
      <span class="wordmark text-sm font-extrabold hidden sm:inline">Kraken</span>
    </div>

    <!-- Search -->
    <div class="flex-1 max-w-md mx-auto" data-signals="{search_term: ''}">
      <div class="search-shell px-3 h-9">
        <span class="text-faint shrink-0">{{ icon('search', 15) }}</span>
        <input id="nav-search" type="text" placeholder="Search songs, albums, artists..."
          class="input-min text-sm h-full"
          data-bind="search_term"
          data-on-keydown="if(evt.key==='Enter' && $search_term.trim()) goto('/search?q=' + encodeURIComponent($search_term))" />
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1 shrink-0">
      <div id="status" class="icon-btn" title="Connecting...">
        <span class="dot dot-off"></span>
      </div>

      {% include "settings.html" %}

      <button class="icon-btn relative" title="Downloads" data-on-click="goto('/downloads')">
        {{ icon('download', 18) }}
        <span class="absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 rounded-full flex items-center justify-center font-bold"
          style="background: var(--accent); color: var(--accent-ink); font-size: 10px; line-height: 1;">
          <p id="overall-completed-tasks" class="text-xs">0</p>
        </span>
      </button>
    </div>
  </div>
</div>
