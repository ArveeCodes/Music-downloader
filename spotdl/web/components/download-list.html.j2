{% from "icons.html.j2" import icon %}
<div id="download-list">
    {% if client_song_downloads|length == 0 %}
    <div class="flex flex-col items-center justify-center py-24 fade-in">
        <span class="text-faint mb-4">{{ icon('download', 36) }}</span>
        <p class="text-muted mb-1">No downloads yet</p>
        <p class="text-faint text-sm mb-6">Search a song or paste a Spotify link to get started</p>
        <button class="btn-accent text-sm" data-on-click="goto('/')">Search music</button>
    </div>
    {% else %}
    <div class="panel">
        {% for d in client_song_downloads %}
        <div class="row">
            <img src="{{ d.song.cover_url|e }}" class="w-11 h-11 rounded-lg object-cover shrink-0" loading="lazy" />

            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate">{{ d.song.name|e }}</p>
                <p class="text-xs text-faint truncate mt-0.5">
                    {{ d.song.artist|e }}{% if d.song.album_name %} &mdash; {{ d.song.album_name|e }}{% endif %}
                </p>
                {% if d.progress > 0 and d.progress < 100 %}
                <progress class="progress-min w-full mt-2" value="{{ d.progress }}" max="100"></progress>
                {% endif %}
            </div>

            <div class="flex items-center gap-2 shrink-0">
                {% if d.message == "Error" %}
                <span class="px-2 py-0.5 rounded-md text-xs font-medium"
                    style="background: rgba(var(--danger-rgb), 0.14); color: var(--danger);">Failed</span>
                {% elif d.progress == 100 %}
                <a class="icon-btn solid" title="Save file"
                    data-attr="{href:'/api/download/file?file={{ d.path|urlencode|replace('/', '%2f') }}&client_id=' + $client_id}" download>
                    {{ icon('download', 16) }}
                </a>
                {% elif d.progress == 0 %}
                <span class="loading loading-spinner loading-xs" style="color: var(--accent);"></span>
                <span class="text-xs text-faint hidden sm:inline">{{ d.message|e }}</span>
                {% else %}
                <span class="text-xs font-mono text-accent">{{ d.progress }}%</span>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
