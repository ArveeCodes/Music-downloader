<div id="download-list">
    <div class="m-2">
        <h1 class="m-4 text-xl">Queue</h1>
        {% if client_song_downloads|length == 0 %}
        <div class="alert alert-info shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                class="stroke-current flex-shrink-0 w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>No downloads are queued.</span>
            <button class="btn btn-sm btn-primary" data-on-click="goto('/')">Search</button>
        </div>
        {% else %}
        <div class="card card-bordered my-2 shadow-lg card-compact bg-base-100">
            {% for client_song_download in client_song_downloads %}
            <div key="{{ loop.index }}" class="card-body flex flex-row items-center gap-4">
                <div class="avatar">
                    <div class="w-14 h-14 rounded">
                        <img src="{{ client_song_download.song.cover_url }}" loading="lazy" />
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="card-title text-sm sm:text-base truncate">
                        {{ client_song_download.song.name }}
                    </h2>
                    <p class="text-xs sm:text-sm opacity-70 truncate">
                        {{ client_song_download.song.artist }} &mdash; {{ client_song_download.song.album_name }}
                    </p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    {% if client_song_download.message == "Error" %}
                    <span class="badge badge-error hidden sm:inline-flex">Error</span>
                    {% elif client_song_download.progress == 100 %}
                    <span class="badge badge-success hidden sm:inline-flex">Done</span>
                    <a class="btn btn-sm btn-square btn-ghost" data-attr="{href:'/api/download/file?file={{ client_song_download.path|urlencode|replace('/', '%2f') }}&client_id=' + $client_id}" download>
                        <iconify-icon icon="clarity:download-line" style="font-size: 20px"></iconify-icon>
                    </a>
                    {% elif client_song_download.progress == 0 %}
                    <span class="badge badge-info hidden sm:inline-flex">{{ client_song_download.message }}</span>
                    <span class="loading loading-spinner loading-sm text-primary"></span>
                    {% else %}
                    <span class="badge badge-warning hidden sm:inline-flex">{{ client_song_download.message }}</span>
                    <div class="flex items-center gap-2">
                        <progress class="progress progress-primary w-20 sm:w-40" value="{{ client_song_download.progress }}" max="100"></progress>
                        <span class="text-xs font-mono">{{ client_song_download.progress }}%</span>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% if not loop.last %}
            <div class="divider my-0 mx-4"></div>
            {% endif %}
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>
