{% extends "base.html.j2" %}

{% block content %}

<div class="min-h-[calc(100vh-8rem)] p-4 max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <button class="btn btn-ghost btn-sm btn-circle" onclick="goto('/')">
            <iconify-icon icon="clarity:arrow-line" style="font-size: 18px; transform: rotate(180deg)"></iconify-icon>
        </button>
        <h1 class="text-xl font-bold">Downloads</h1>
    </div>

    <div id="download-list" data-on-load="@get('/client/downloads')">
        <div class="flex flex-col items-center justify-center py-20 gap-4 fade-in">
            <span class="loading loading-ring loading-lg text-primary"></span>
            <span class="text-base-content/50">Loading downloads...</span>
        </div>
    </div>
</div>

{% endblock content %}
