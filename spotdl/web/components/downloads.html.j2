{% extends "base.html.j2" %}
{% block content %}
{% from "icons.html.j2" import icon %}
<div class="min-h-screen px-4 py-8">
    <div class="max-w-3xl mx-auto fade-in">
        <div class="flex items-center gap-2.5 mb-5">
            <span class="text-accent">{{ icon('download', 20) }}</span>
            <h1 class="text-xl font-semibold">Downloads</h1>
        </div>

    {# Container for YouTube Music playlist / album progress cards #}
    <div id="ytm-downloads"></div>

        <div id="download-list" data-on-load="@get('/client/downloads')">
            <div class="flex items-center justify-center py-24">
                <span class="loading loading-spinner loading-md" style="color: var(--accent);"></span>
            </div>
        </div>
    </div>
</div>
{% endblock content %}
