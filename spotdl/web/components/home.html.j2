{% extends "base.html.j2" %}

{% block content %}

<span id="component-home">
    <div class="hero min-h-[80vh]">
        <div class="block text-center justify-center hero-content">
            <div class="flex items-center justify-center">
                <img src="/assets/spotdl.svg" class="mb-5 w-32 center" />
            </div>
            <div>
                <h1 class="mb-5 text-5xl font-bold text-base-content">spotDL</h1>
                <p class="mb-5 text-base-content">
                    Download your Spotify songs with embedded album art and metadata
                </p>
            </div>

            <div class="w-full max-w-xl" data-signals="{home_search: ''}">
                <div class="join w-full">
                    <input type="text" placeholder="Paste a Spotify URL or search for a song..."
                        class="input input-bordered join-item w-full"
                        data-bind="home_search"
                        data-on-keydown="if (evt.key === 'Enter' && $home_search.trim()) goto('/search?q=' + encodeURIComponent($home_search))" />
                    <button class="btn btn-primary join-item"
                        data-on-click="if ($home_search.trim()) goto('/search?q=' + encodeURIComponent($home_search))">
                        <iconify-icon icon="clarity:search-line" style="font-size: 20px"></iconify-icon>
                        Search
                    </button>
                </div>
                <div class="flex flex-wrap justify-center gap-2 mt-4">
                    <span class="badge badge-outline badge-lg">Songs</span>
                    <span class="badge badge-outline badge-lg">Albums</span>
                    <span class="badge badge-outline badge-lg">Playlists</span>
                    <span class="badge badge-outline badge-lg">Artists</span>
                </div>
            </div>
        </div>
    </div>
</span>
{% endblock content %}
