{% extends "base.html.j2" %}

{% block content %}

<div class="hero min-h-[calc(100vh-4rem)]">
    <div class="hero-content text-center max-w-2xl mx-auto px-4">
        <div class="fade-in">
            <div class="flex justify-center mb-6">
                <div class="relative">
                    <img src="/assets/spotdl.svg" class="w-24 sm:w-28 relative z-10" alt="spotDL" />
                    <div class="absolute inset-0 blur-3xl opacity-20 bg-primary scale-150"></div>
                </div>
            </div>

            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3">
                spot<span class="text-primary">DL</span>
            </h1>
            <p class="text-base-content/60 text-lg mb-8 max-w-md mx-auto">
                Download your Spotify & YouTube Music playlists, albums, and songs with full metadata
            </p>

            <div class="w-full max-w-lg mx-auto mb-6" data-signals="{home_search: ''}">
                <div class="join w-full shadow-xl glow-border rounded-xl">
                    <input type="text" placeholder="Paste a Spotify or YouTube Music URL, or search for a song..."
                        class="input input-lg join-item w-full bg-base-100 border-base-content/10 focus:border-primary/50 text-base"
                        data-bind="home_search"
                        data-on-keydown="evt.key === 'Enter' && $home_search && goto('/search?q=' + encodeURIComponent($home_search))">
                    <button class="btn btn-lg btn-primary join-item px-6"
                        data-on-click="$home_search && goto('/search?q=' + encodeURIComponent($home_search))">
                        <iconify-icon icon="clarity:search-line" style="font-size: 22px"></iconify-icon>
                    </button>
                </div>
            </div>

            <div class="flex flex-wrap gap-2 justify-center mb-10">
                <span class="badge badge-outline badge-lg gap-1.5 text-base-content/50 hover:text-base-content hover:border-primary/50 cursor-default transition-colors">
                    <iconify-icon icon="clarity:music-note-line" style="font-size: 14px"></iconify-icon>
                    Songs
                </span>
                <span class="badge badge-outline badge-lg gap-1.5 text-base-content/50 hover:text-base-content hover:border-primary/50 cursor-default transition-colors">
                    <iconify-icon icon="clarity:cd-dvd-line" style="font-size: 14px"></iconify-icon>
                    Albums
                </span>
                <span class="badge badge-outline badge-lg gap-1.5 text-base-content/50 hover:text-base-content hover:border-primary/50 cursor-default transition-colors">
                    <iconify-icon icon="clarity:list-line" style="font-size: 14px"></iconify-icon>
                    Playlists
                </span>
                <span class="badge badge-outline badge-lg gap-1.5 text-base-content/50 hover:text-base-content hover:border-primary/50 cursor-default transition-colors">
                    <iconify-icon icon="clarity:users-line" style="font-size: 14px"></iconify-icon>
                    Artists
                </span>
                <span class="badge badge-outline badge-lg gap-1.5 cursor-default transition-colors"
                      style="color: #ff0000; border-color: #ff000040;" title="YouTube Music playlists &amp; albums supported">
                    <iconify-icon icon="mdi:youtube-music" style="font-size: 14px"></iconify-icon>
                    YouTube Music
                </span>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <button class="btn btn-ghost btn-sm gap-2 text-base-content/50" onclick="goto('/downloads')">
                    <iconify-icon icon="clarity:download-cloud-line" style="font-size: 16px"></iconify-icon>
                    View downloads
                </button>
                <span class="text-base-content/20 hidden sm:inline">|</span>
                <span class="text-xs text-base-content/30">v{{ __version__ }}</span>
            </div>
        </div>
    </div>
</div>

{% endblock content %}
