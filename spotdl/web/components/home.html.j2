{% extends "base.html.j2" %}
{% block content %}
{% from "icons.html.j2" import icon %}
<span id="component-home">
    <div class="flex items-center justify-center px-4 py-12" style="min-height: calc(100vh - 140px);">
        <div class="w-full max-w-2xl mx-auto text-center fade-in">

            <img src="/assets/spotdl.svg" class="w-16 h-16 mx-auto mb-6" alt="Kraken" />

            <h1 class="text-5xl sm:text-6xl font-black mb-4">
                <span class="wordmark">Kraken</span>
            </h1>
            <p class="text-lg text-muted mb-10">
                Paste a link. Keep the music.
            </p>

            <div class="max-w-xl mx-auto" data-signals="{home_search: ''}">
                <div class="search-shell pl-4 pr-1.5 h-12">
                    <span class="text-faint shrink-0">{{ icon('search', 17) }}</span>
                    <input type="text"
                        placeholder="Search or paste a Spotify link..."
                        class="input-min text-base h-full"
                        data-bind="home_search"
                        data-on-keydown="if (evt.key === 'Enter' && $home_search.trim()) goto('/search?q=' + encodeURIComponent($home_search))" />
                    <button class="btn-accent text-sm shrink-0" style="padding: 7px 18px;"
                        data-on-click="if ($home_search.trim()) goto('/search?q=' + encodeURIComponent($home_search))">
                        Search
                    </button>
                </div>
                <p class="text-faint text-xs mt-4">
                    Songs &middot; Albums &middot; Playlists &middot; Artists
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-14 text-left">
                <div class="panel p-4">
                    <span class="text-accent">{{ icon('search', 18) }}</span>
                    <p class="text-sm font-medium mt-3">Search or paste</p>
                    <p class="text-xs text-faint mt-1">Any Spotify song, album, playlist or artist</p>
                </div>
                <div class="panel p-4">
                    <span class="text-accent">{{ icon('download', 18) }}</span>
                    <p class="text-sm font-medium mt-3">Watch it download</p>
                    <p class="text-xs text-faint mt-1">Live progress for every track</p>
                </div>
                <div class="panel p-4">
                    <span class="text-accent">{{ icon('disc', 18) }}</span>
                    <p class="text-sm font-medium mt-3">Keep it organized</p>
                    <p class="text-xs text-faint mt-1">Albums and playlists get their own folder, with cover art and lyrics</p>
                </div>
            </div>

        </div>
    </div>
</span>
{% endblock content %}
